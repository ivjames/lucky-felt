# Lucky Felt API — environment. On the droplet this lives at
# /var/www/casino-api/.env (mode 600) and is sourced by `casino deploy`
# before every pm2 restart. Quote any value containing spaces.

PORT=3001
CASINO_DB=/var/data/casino.db
NODE_ENV=production

# Sign-in code delivery (Resend over SMTP). With none of these set the code is
# only logged to the server console.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxx
MAIL_FROM='Lucky Felt Casino <no-reply@casino.lab980.com>'

# Dev only. Never set in production; the server ignores it when
# NODE_ENV=production anyway.
# AUTH_DEV_ECHO=1
