#!/usr/bin/env bash
# casino — operate CLI for casino.lab980.com (Lucky Felt Casino).
#
# One repo, two halves on the droplet:
#
#   frontend  `npm run build` -> dist/ in THIS checkout; nginx serves it as
#             static files (root /var/www/lucky-felt/dist).
#   API       the repo's server/ directory, copied on each deploy into
#             $CASINO_API_DIR (default /var/www/casino-api) and run there by
#             pm2 as `casino-api` on 127.0.0.1:3001. nginx proxies /api/ to it.
#             Its .env and the SQLite file live outside the checkout and
#             survive deploys.
#
#   casino setup                one-time on a box: symlink, seed the API .env
#                               from the running pm2 process, deploy, THEN pin
#                               the vhost's proxy_pass to 127.0.0.1:3001
#                               (prefix kept). Idempotent; safe to re-run.
#   casino deploy [--no-build]  sync checkout -> build frontend -> copy server/
#                               into the API dir -> npm ci there -> pm2
#                               restart (or first start) -> probe
#   casino restart              pm2 restart casino-api + probe, no code change
#   casino logs [-n N]          tail the pm2 logs for casino-api
#   casino status               HEAD, deployed API commit, pm2 state,
#                               local + public probes, cert days
#
# Env overrides:
#   CASINO_FQDN      default casino.lab980.com
#   CASINO_BRANCH    default main
#   CASINO_PORT      default 3001   (the API's port; predates the 8060+ range)
#   CASINO_API_DIR   default /var/www/casino-api
#   CASINO_PM2_NAME  default casino-api
#   CASINO_VHOST     default: the file under /etc/nginx/sites-available whose
#                    server_name includes $CASINO_FQDN
#
# The checkout is wherever this script lives (normally /var/www/lucky-felt),
# derived from the script's own path so the /usr/local/bin symlink resolves
# back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${CASINO_FQDN:-casino.lab980.com}"
BRANCH="${CASINO_BRANCH:-main}"
CLI_PORT="${CASINO_PORT:-3001}"   # what the CLI probes; the API itself reads PORT from .env
API_DIR="${CASINO_API_DIR:-/var/www/casino-api}"
APP="${CASINO_PM2_NAME:-casino-api}"
STAMP=".deployed-commit"   # written into $API_DIR after activation so `status` can say what is live

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
casino — operate casino.lab980.com (static frontend + pm2 API behind nginx).

Usage:
  casino setup                 one-time on a box: symlink, seed .env from pm2,
                               deploy, then pin the vhost proxy_pass (idempotent)
  casino deploy [--no-build]   sync checkout, build dist/, copy server/ to the
                               API dir, npm ci there, pm2 restart, probe
  casino restart               pm2 restart casino-api + probe
  casino logs [-n N]           tail pm2 logs for casino-api
  casino status                HEAD + deployed API commit + pm2 + probes + cert

Env: CASINO_FQDN, CASINO_BRANCH (default main), CASINO_PORT (default 3001),
     CASINO_API_DIR (default /var/www/casino-api), CASINO_PM2_NAME (default casino-api),
     CASINO_VHOST (default: the sites-available file naming CASINO_FQDN).
USAGE
}

# Export the API's .env into this shell so `pm2 start` / `pm2 restart
# --update-env` carry it. Values with spaces (MAIL_FROM) must be quoted in the
# file; see server/.env.example.
load_env() {
  if [ -f "$API_DIR/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$API_DIR/.env"
    set +a
    # The port lives in three places: the vhost's proxy_pass, the API's .env,
    # and this CLI's probe. A mismatch is a 502 that looks like a dead app.
    if [ -n "${PORT:-}" ] && [ "$PORT" != "$CLI_PORT" ]; then
      warn ".env sets PORT=$PORT but this CLI probes $CLI_PORT (CASINO_PORT) — nginx's proxy_pass must match the .env value"
    fi
  fi
}

# GET a health URL and classify it. A bare 200 is not proof the API answered:
# a vhost with no /api/ location falls through the SPA's try_files and serves
# index.html with 200. Prints "<code> <ok|body|->" for the caller.
health_get() {
  local out code body
  out="$(curl -s --max-time 10 -w '\n%{http_code}' "$1" 2>/dev/null || true)"
  code="${out##*$'\n'}"; body="${out%$'\n'*}"
  [ -n "$code" ] || code=000
  if [ "$code" = "200" ]; then
    if printf '%s' "$body" | grep -qE '"ok"[[:space:]]*:[[:space:]]*true'; then printf '200 ok'; else printf '200 body'; fi
  else
    printf '%s -' "$code"
  fi
}

# Local probe: IPv4 loopback first, then IPv6. The API binds 127.0.0.1, and
# so does every vhost provision-site writes; but this app once ran bound to
# ::1 only (lab980 docs/admin-tool.md, finding 7), so report the family
# rather than calling a v6-only-but-healthy process dead.
local_probe() {
  local r
  r="$(health_get "http://127.0.0.1:$CLI_PORT/api/health")"
  if [ "$r" = "200 ok" ]; then printf '200 ok v4'; return; fi
  r="$(health_get "http://[::1]:$CLI_PORT/api/health")"
  if [ "$r" = "200 ok" ]; then printf '200 ok v6-only'; return; fi
  printf '%s -' "$r"
}

describe() { # <code> <ok|body|-> -> human suffix
  case "$2" in
    ok)   printf 'HTTP %s, {"ok":true}' "$1";;
    body) printf 'HTTP %s but not the API'"'"'s JSON (SPA fallback? wrong upstream?)' "$1";;
    *)    printf 'HTTP %s' "$1";;
  esac
}

probe() {
  # Three probes because three things can be broken independently: the API
  # process, nginx's /api/ proxy, and nginx's static root. Local /api/health
  # failing points at the app; local OK but public /api/ failing points at the
  # proxy; public / failing points at the static root or the vhost itself.
  # The two API probes require the JSON body, not just a 200. Returns nonzero
  # if any probe fails, so deploy/restart can fail instead of printing a
  # broken rollout and exiting 0.
  local l lk lfam p pk s fail=0
  read -r l lk lfam <<<"$(local_probe)"
  read -r p pk <<<"$(health_get "https://$FQDN/api/health")"
  s="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/" || true)"
  printf 'api local:  http://127.0.0.1:%s/api/health  ->  %s%s\n' "$CLI_PORT" "$(describe "$l" "$lk")" "$([ "$lfam" = "v6-only" ] && printf ' (answered on [::1] only)')"
  printf 'api public: https://%s/api/health  ->  %s\n' "$FQDN" "$(describe "$p" "$pk")"
  printf 'site:       https://%s/  ->  HTTP %s\n' "$FQDN" "${s:-000}"
  [ "$lk" = "ok" ] || { fail=1; warn "local API probe failed: $APP is not serving /api/health on loopback port $CLI_PORT (check 'casino logs')"; }
  [ "$lfam" = "v6-only" ] && warn "$APP is bound to ::1 only. The vhost must proxy to 'localhost' for this to work; the current server binds 127.0.0.1, so a deploy fixes it — then pin proxy_pass to 127.0.0.1:$CLI_PORT."
  [ "$pk" = "ok" ] || { fail=1; warn "public API probe failed: nginx is not proxying /api/ to the API (missing/misrouted /api/ location, or DNS/TLS for $FQDN is off)"; }
  [ "$s" = "200" ] || { fail=1; warn "public site probe failed: nginx is not serving dist/ for $FQDN"; }
  return "$fail"
}

pm2_registered() { pm2 describe "$APP" >/dev/null 2>&1; }

# Where does pm2 actually run the API from? If the process exists, its script
# path is the truth about the box; the default /var/www/casino-api is only a
# guess. Copying server/ anywhere else restarts a process that never sees it.
pm2_script_path() {
  pm2 jlist 2>/dev/null | APP="$APP" python3 -c '
import json,os,sys
try: procs=json.load(sys.stdin)
except Exception: procs=[]
p=[x for x in procs if x.get("name")==os.environ["APP"]]
e=(p[0].get("pm2_env") or {}) if p else {}
print(e.get("pm_exec_path") or "")' 2>/dev/null || true
}
resolve_api_dir() {
  [ -n "${CASINO_API_DIR:-}" ] && return   # explicit override wins
  local sp; sp="$(pm2_script_path)"
  [ -n "$sp" ] || return
  local d; d="$(dirname "$sp")"
  if [ "$(readlink -f "$d")" != "$(readlink -f "$API_DIR")" ]; then
    warn "pm2 runs $APP from $sp, not $API_DIR/index.js — using $d as the API dir (set CASINO_API_DIR to override)"
    API_DIR="$d"
  fi
  case "$(basename "$sp")" in
    index.js) ;;
    *) warn "pm2's script for $APP is $(basename "$sp"), not index.js; deploy copies server/ next to it and restarts, but check that is what you want";;
  esac
}

# Copy the tracked contents of server/ at HEAD into $API_DIR. `git archive`
# emits exactly what is committed, so node_modules, .env and *.db (all
# untracked) are never touched. Files deleted from server/ between the previous
# and the new commit are removed first so a stale module can't linger.
# --no-renames: with rename detection on, a renamed file is not a deletion and
# its old path would survive in the API dir.
sync_api() {
  local before="$1" after="$2"
  if [ "$(readlink -f "$API_DIR")" = "$ROOT/server" ]; then
    log "API dir is the checkout's server/ — nothing to copy"
    return
  fi
  mkdir -p "$API_DIR"
  if [ -n "$before" ] && [ "$before" != "$after" ]; then
    git diff --no-renames --name-only --diff-filter=D "$before" "$after" -- server/ \
      | sed 's#^server/##' \
      | while IFS= read -r f; do
          [ -n "$f" ] && rm -f "$API_DIR/$f" && log "removed $API_DIR/$f"
        done
  fi
  log "Copying server/ @ $after -> $API_DIR"
  git archive --format=tar "$after:server" | tar -x -C "$API_DIR"
}

# Written only once npm ci and the pm2 restart/start have succeeded, so
# `status` reports the commit that is actually running, not one that was
# copied in and then failed to activate.
stamp_api() { printf '%s\n' "$1" > "$API_DIR/$STAMP"; }


# ---- vhost ---------------------------------------------------------------
# The API's location block must keep the /api prefix: `proxy_pass
# http://127.0.0.1:PORT;` does, `proxy_pass http://host:PORT/;` (trailing
# slash) strips it. The server answers both since it mounts its routes at /api
# and /, but the convention on this box is the former, on 127.0.0.1, with the
# forwarded headers the rate limiter needs.
vhost_file() {
  if [ -n "${CASINO_VHOST:-}" ]; then printf '%s' "$CASINO_VHOST"; return; fi
  local f
  f="$(grep -lE "^\s*server_name\s+.*\b$FQDN\b" /etc/nginx/sites-available/* /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf 2>/dev/null | head -1 || true)"
  printf '%s' "$f"
}
vhost_proxy_lines() { # every proxy_pass pointing at the API port
  grep -nE "proxy_pass\s+http://(localhost|127\.0\.0\.1|\[::1\]):$CLI_PORT[^;]*;" "$1" 2>/dev/null || true
}
# For one API proxy_pass line, find its enclosing location block and report
# whether that block already sets X-Forwarded-For. Blocks here are flat; a
# nested `if` would only make us insert once more than needed.
block_has_xff() { # <file> <lineno>
  local f="$1" ln="$2" start end
  start="$(head -n "$ln" "$f" | grep -nE '^\s*location\b.*\{' | tail -1 | cut -d: -f1)"
  [ -n "$start" ] || start="$ln"
  end="$(tail -n +"$ln" "$f" | grep -nE '^\s*\}' | head -1 | cut -d: -f1)"
  end=$(( ln + ${end:-1} - 1 ))
  sed -n "${start},${end}p" "$f" | grep -q "X-Forwarded-For"
}
insert_headers_after() { # <file> <lineno>
  local f="$1" ln="$2" indent
  indent="$(sed -n "${ln}p" "$f" | sed -E 's/^([[:space:]]*).*/\1/')"
  sed -i "${ln}a\\
${indent}proxy_http_version 1.1;\\
${indent}proxy_set_header Host \$host;\\
${indent}proxy_set_header X-Real-IP \$remote_addr;\\
${indent}proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\\
${indent}proxy_set_header X-Forwarded-Proto \$scheme;" "$f"
}
vhost_pin() {
  local f; f="$(vhost_file)"
  if [ -z "$f" ] || [ ! -w "$f" ]; then warn "no writable vhost for $FQDN found (set CASINO_VHOST, or run as root); leaving nginx alone"; return; fi
  if [ -z "$(vhost_proxy_lines "$f")" ]; then
    warn "$f has no proxy_pass to a loopback host on port $CLI_PORT; not touching it. Its proxy lines are:"
    grep -nE "proxy_pass|upstream" "$f" | sed 's/^/       /' >&2 || true
    warn "if the API location uses an upstream name, pin it by hand: proxy_pass http://127.0.0.1:$CLI_PORT; (no trailing slash)"
    return
  fi
  local bak; bak="$f.bak.$(date +%Y%m%d%H%M%S)"
  cp -p "$f" "$bak"
  sed -i -E "s#(proxy_pass\s+)http://(localhost|127\.0\.0\.1|\[::1\]):$CLI_PORT[^;]*;#\1http://127.0.0.1:$CLI_PORT;#" "$f"
  # Every API location gets the forwarded headers if its own block lacks them.
  # Walk the matches bottom-up so insertions don't shift the lines still to do.
  local ln
  for ln in $(grep -nE "proxy_pass\s+http://127\.0\.0\.1:$CLI_PORT;" "$f" | cut -d: -f1 | sort -rn); do
    block_has_xff "$f" "$ln" || insert_headers_after "$f" "$ln"
  done
  if cmp -s "$f" "$bak"; then log "vhost $f already pinned"; rm -f "$bak"; return; fi
  log "vhost $f: API proxy_pass pinned to http://127.0.0.1:$CLI_PORT; (backup: $bak)"
  if command -v nginx >/dev/null 2>&1; then
    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx 2>/dev/null || nginx -s reload
      log "nginx reloaded"
    else
      # Never leave a config nginx rejects on disk: the running nginx survives,
      # but the next reload or reboot would not.
      cp -p "$bak" "$f"
      die "nginx -t rejected the edited $f; restored it from $bak. Pin the API location by hand (proxy_pass http://127.0.0.1:$CLI_PORT; plus the forwarded headers) and run: nginx -t"
    fi
  else
    warn "nginx not found on PATH; edited $f but did not reload"
  fi
}
vhost_check() { # warn about anything setup would change; never edits
  local f; f="$(vhost_file)"
  if [ -z "$f" ] || [ ! -r "$f" ]; then warn "no readable vhost for $FQDN found (set CASINO_VHOST); skipping vhost check"; return; fi
  local bad ln
  bad="$(vhost_proxy_lines "$f" | grep -vE "proxy_pass\s+http://127\.0\.0\.1:$CLI_PORT;" || true)"
  [ -n "$bad" ] && warn "$f proxies the API as:"$'\n'"$bad"$'\n'"       expected: proxy_pass http://127.0.0.1:$CLI_PORT;  (run 'casino setup' to pin it)"
  for ln in $(grep -nE "proxy_pass\s+http://127\.0\.0\.1:$CLI_PORT;" "$f" | cut -d: -f1); do
    block_has_xff "$f" "$ln" || warn "$f line $ln: this API location sets no X-Forwarded-For; rate limits key on 127.0.0.1 ('casino setup' adds the headers)"
  done
  return 0
}

# ---- .env seeding --------------------------------------------------------
# If the API has no .env yet but a pm2 process is already running (the state
# of the box before this CLI existed: env given on the original `pm2 start`
# line), capture those values so nothing is lost when deploy restarts with
# --update-env. Otherwise seed from server/.env.example.
ENV_KEYS="PORT HOST CASINO_DB NODE_ENV SMTP_URL SMTP_HOST SMTP_PORT SMTP_SECURE SMTP_USER SMTP_PASS MAIL_FROM"
seed_env() {
  local envf="$API_DIR/.env"
  mkdir -p "$API_DIR"
  if [ -f "$envf" ]; then log ".env present at $envf (kept)"; return; fi
  # Build the file in a temp beside the target and rename it into place only
  # once everything succeeded: a half-written .env would be trusted next run.
  local tmp; tmp="$(mktemp "$API_DIR/.env.XXXXXX")"; chmod 600 "$tmp"
  if pm2_registered; then
    log "capturing env from the running pm2 process $APP into $envf"
    if ! pm2 jlist 2>/dev/null | ENV_KEYS="$ENV_KEYS" APP="$APP" python3 -c '
import json,os,sys
procs=json.load(sys.stdin)
p=[x for x in procs if x.get("name")==os.environ["APP"]]
e=(p[0].get("pm2_env") or {}) if p else {}
q=lambda v: "'"'"'"+str(v).replace("'"'"'","'"'"'\\'"'"''"'"'")+"'"'"'"
for k in os.environ["ENV_KEYS"].split():
    if k in e and e[k] not in (None,""): print(f"{k}={q(e[k])}")
' > "$tmp"; then
      rm -f "$tmp"
      die "could not read the environment of pm2 process $APP (pm2 jlist failed); nothing written to $envf"
    fi
    grep -q '^PORT=' "$tmp" || printf 'PORT=%s\n' "$CLI_PORT" >> "$tmp"
    grep -q '^NODE_ENV=' "$tmp" || printf 'NODE_ENV=production\n' >> "$tmp"
  else
    warn "no pm2 process $APP yet; seeding $envf from server/.env.example — fill in SMTP_PASS and check CASINO_DB before relying on it"
    cat "$ROOT/server/.env.example" > "$tmp"
  fi
  mv "$tmp" "$envf"
  log "wrote $envf:"; sed -E 's/^(SMTP_PASS|SMTP_URL)=.*/\1=<redacted>/' "$envf" | sed 's/^/    /'
  # the DB directory must exist before the API starts
  local dbp; dbp="$(grep -E '^CASINO_DB=' "$envf" | head -1 | cut -d= -f2- | tr -d "'\"")"
  [ -n "$dbp" ] && mkdir -p "$(dirname "$dbp")"
}

cmd_setup() {
  cd "$ROOT"
  resolve_api_dir
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."
  log "symlink /usr/local/bin/casino -> $SELF"
  ln -sf "$SELF" /usr/local/bin/casino 2>/dev/null || warn "could not write /usr/local/bin/casino (not root?)"
  seed_env
  # Deploy BEFORE pinning the vhost: the pre-CLI process may be bound to ::1
  # only, so switching nginx to 127.0.0.1 first would 502 the site for the
  # length of the build. The new process binds 127.0.0.1 and answers both
  # prefixes, so it works behind the old vhost; then the pin makes it right.
  SOFT_PROBE=1 cmd_deploy "$@"
  vhost_pin
  sleep 1
  log "setup done; final probe"
  probe || die "setup finished but a health probe still fails (see above)"
}

cmd_deploy() {
  resolve_api_dir
  local DO_BUILD=1
  [ "${1:-}" = "--no-build" ] && DO_BUILD=0
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."

  local before after prev_api
  before="$(git rev-parse --short HEAD)"
  prev_api="$(cat "$API_DIR/$STAMP" 2>/dev/null || true)"
  # A stamp that isn't a commit we know (hand-edited, or from a repo history
  # rewrite) would make the deletion diff fatal; fall back to HEAD instead.
  if [ -n "$prev_api" ] && ! git cat-file -e "$prev_api^{commit}" 2>/dev/null; then
    warn "ignoring unrecognised $STAMP value '$prev_api'"; prev_api=""
  fi
  log "Syncing $ROOT to origin/$BRANCH"
  git fetch --quiet origin "$BRANCH"
  git reset --hard --quiet "origin/$BRANCH"
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then log "already current ($after)"
  else log "$before -> $after"; git --no-pager log --oneline "$before..$after"; fi

  # Frontend. npm ci, not npm install: the lockfile is the deployed dependency
  # set, and a deploy that resolves different versions than were tested is
  # the bug you find at 2am.
  if [ "$DO_BUILD" -eq 1 ]; then
    log "npm ci (frontend)"; npm ci
    log "npm run build"; npm run build
  else
    warn "--no-build: dist/ left as it was"
  fi

  # API. Diff deletions against the commit the API dir last ACTIVATED, which
  # may be older than $before if a previous deploy failed after copying.
  sync_api "${prev_api:-$before}" "$after"
  log "npm ci (API)"
  ( cd "$API_DIR" && npm ci --omit=dev )

  load_env
  if pm2_registered; then
    log "pm2 restart $APP"
    pm2 restart "$APP" --update-env
  else
    warn "pm2 has no process named $APP — starting it (first deploy)"
    [ -f "$API_DIR/.env" ] || warn "$API_DIR/.env is missing; the API will run with defaults (DB in the API dir, no SMTP)"
    ( cd "$API_DIR" && pm2 start index.js --name "$APP" )
  fi
  pm2 save
  stamp_api "$after"
  vhost_check
  sleep 2
  if [ "${SOFT_PROBE:-0}" = "1" ]; then
    probe || warn "a probe failed before the vhost pin; re-probing after it"
  else
    probe || die "deploy finished but a health probe failed — the rollout is NOT confirmed good (see above)"
  fi
}

cmd_restart() {
  resolve_api_dir
  pm2_registered || die "pm2 has no process named $APP — run 'casino deploy' first"
  load_env
  log "pm2 restart $APP"
  pm2 restart "$APP" --update-env
  sleep 2
  probe || die "restart finished but a health probe failed (see above)"
}

cmd_logs() { pm2 logs "$APP" "$@"; }

cmd_status() {
  cd "$ROOT"
  resolve_api_dir
  printf 'checkout:   %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  if [ -f "$API_DIR/$STAMP" ]; then
    printf 'api dir:    %s @ %s\n' "$API_DIR" "$(cat "$API_DIR/$STAMP")"
  else
    printf 'api dir:    %s (no %s — not yet deployed by this CLI)\n' "$API_DIR" "$STAMP"
  fi
  printf 'pm2:        '
  pm2 jlist 2>/dev/null \
    | python3 -c "import json,sys
try: procs=json.load(sys.stdin)
except Exception: procs=[]
p=[x for x in procs if x.get('name')=='$APP']
if not p: print('not registered'); raise SystemExit
e=p[0].get('pm2_env',{})
print('%s  mode=%s  restarts=%s  script=%s' % (
  e.get('status'), e.get('exec_mode'), e.get('restart_time'), e.get('pm_exec_path') or e.get('pm_cwd')))" 2>/dev/null \
    || printf 'unknown (pm2 not readable)\n'
  local vf; vf="$(vhost_file)"
  if [ -n "$vf" ]; then printf 'vhost:      %s\n' "$vf"; vhost_proxy_lines "$vf" | sed 's/^/            /'; else printf 'vhost:      (none found for %s)\n' "$FQDN"; fi
  probe || true
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:       %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:       (run as root to read expiry)\n'
  fi
}

case "${1:-}" in
  setup)   shift; cmd_setup "$@";;
  deploy)  shift; cmd_deploy "$@";;
  restart) shift; cmd_restart "$@";;
  logs)    shift; cmd_logs "$@";;
  status)  shift; cmd_status "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
